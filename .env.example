# Environment for docker-compose.yml. Copy to .env (git-ignored) and change the passwords.
# The values below match backend/src/main/resources/application-local.yml so a backend started
# with `./mvnw spring-boot:run` connects to these containers with no extra configuration.

# --- PostgreSQL ---
POSTGRES_DB=bos
POSTGRES_USER=bos
POSTGRES_PASSWORD=bos_local_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=bos_redis_local_dev
REDIS_PORT=6379

# --- Object storage (MinIO, S3-compatible) ---
STORAGE_BUCKET=bos-local
STORAGE_ACCESS_KEY=bos_minio
STORAGE_SECRET_KEY=bos_minio_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Full stack (`docker compose --profile app up`) ---
# Port Nginx is published on.
WEB_PORT=8088
# Spring profile for the backend container: prod = JSON logs, API docs off.
SPRING_PROFILES_ACTIVE=prod
# Set to true to expose /swagger-ui.html and /v3/api-docs through Nginx.
API_DOCS_ENABLED=false
# Only needed if a browser origin other than Nginx itself calls the API. Comma-separated.
CORS_ALLOWED_ORIGINS=
